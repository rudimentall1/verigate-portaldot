# PortalDot V3 EVM network settings are intentionally blank until independently confirmed.
# Do not copy guessed endpoints or chain IDs into a real deployment environment.
PORTALDOT_RPC_URL=
PORTALDOT_CHAIN_ID=
PORTALDOT_GUARD_ADDRESS=

# Required only for an actual deployment. Never commit the real value.
DEPLOYER_PRIVATE_KEY=

# Dedicated EVM bridge key. Its derived address must match the address configured in the contract.
BRIDGE_SIGNER_PRIVATE_KEY=
AUTHORITY_SIGNER_ADDRESS=

# Path to the trusted issuer public key PEM. Verify its fingerprint through a trusted channel.
VERIGATE_PUBLIC_KEY_FILE=

# API verification is a secondary check after local Ed25519 verification.
VERIGATE_BASE_URL=http://127.0.0.1:8000
VERIGATE_API_KEY=
