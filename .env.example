# PortalDot V3 EVM testnet: endpoint/chain ID sourced from Portaldot Discord #dev-announcement (16 Oct 2026)
# and corroborated by live-testnet notes published by another Hacker House team on 18 Oct.
PORTALDOT_RPC_URL=https://test-evm-rpc-v3.portaldot.dev
PORTALDOT_CHAIN_ID=420420777
# Mandatory wrong-network guard for preflight, cost estimation and deployment.
# Obtain the exact value from a separately trusted PortalDot source; do not copy it from the RPC being checked.
PORTALDOT_GENESIS_HASH=
PORTALDOT_GUARD_ADDRESS=
# Set after verifying the deployed runtime bytecode hash.
PORTALDOT_GUARD_CODE_HASH=

# Public EVM address used only for read-only deployment cost/balance estimates.
# Can be set without a private key. The estimator never signs or broadcasts.
DEPLOYMENT_ESTIMATE_FROM=

# Required only for an actual deployment. Never commit the real value.
DEPLOYER_PRIVATE_KEY=

# Dedicated EVM bridge key. Its derived address must match the address configured in the contract.
BRIDGE_SIGNER_PRIVATE_KEY=
AUTHORITY_SIGNER_ADDRESS=

# Path to the trusted issuer public key PEM.
VERIGATE_PUBLIC_KEY_FILE=
# SHA-256 of the public key's DER SubjectPublicKeyInfo, independently verified via a trusted channel.
VERIGATE_PUBLIC_KEY_SHA256=

# API verification is a secondary check after local Ed25519 verification.
VERIGATE_BASE_URL=http://127.0.0.1:8000
VERIGATE_API_KEY=
