# PortalDot V3 testnet parameters confirmed by the PortalDot team in Discord on 19 Oct 2026.
# EVM write entrypoints are restricted to testnet chain ID 420420777 and its official RPC host.
# Mainnet V3 EVM RPC/chain identity are not configured. Do not infer them from an explorer URL.
PORTALDOT_RPC_URL=https://test-evm-rpc-v3.portaldot.dev
PORTALDOT_CHAIN_ID=420420777
# Native Substrate identity is separate from EVM chain ID; this genesis hash was confirmed by PortalDot.
PORTALDOT_SUBSTRATE_RPC_URL=wss://test-node-v3.portaldot.dev
PORTALDOT_SUBSTRATE_GENESIS_HASH=0xd4f9acbcf7f52388d8b095abe3c198d19fc510e0343e643e87cfbccb155283bd
# Native Substrate adapter: address is safe for dry-run fee/balance reads; URI is required only with --broadcast.
# Never commit a real secret URI/mnemonic. This signer key is separate from EVM bridge/authority keys.
PORTALDOT_SUBSTRATE_SIGNER_ADDRESS=
PORTALDOT_SUBSTRATE_SIGNER_URI=
PORTALDOT_SUBSTRATE_REPLAY_DIR=.verigate-substrate-replay
# Active EVM signing profile. v1 is the compatibility default; use v2 only after independent V2 verification.
PORTALDOT_GUARD_PROFILE=v1
PORTALDOT_GUARD_ADDRESS=
PORTALDOT_GUARD_CODE_HASH=

# PortalDotAgentGuardV2 deployment reported on 2026-10-22. Run npm run verify:deployment:v2 before use.
PORTALDOT_V2_GUARD_ADDRESS=0x87C494a5e4B0A8E055F283767579667E10E046C6
PORTALDOT_V2_GUARD_CODE_HASH=0x010a565cad83a33442d0f23f6fcb6f605a76082a5b58434813bedf84c54f0859
PORTALDOT_V2_DEPLOYMENT_TX_HASH=0x331c1fc027da51af26ed5ee92ef22a8250fe4efdf0d84526f5fe2203f5d3494b

# Public EVM address used only for read-only deployment cost/balance estimates.
DEPLOYMENT_ESTIMATE_FROM=

# Required only for an actual EVM contract deployment. Never commit the real value.
DEPLOYER_PRIVATE_KEY=

# Dedicated EVM bridge key. Its derived address must match the contract's authority signer.
BRIDGE_SIGNER_PRIVATE_KEY=
AUTHORITY_SIGNER_ADDRESS=

# Path to the trusted Verigate issuer public key PEM and its independently verified fingerprint.
VERIGATE_PUBLIC_KEY_FILE=
VERIGATE_PUBLIC_KEY_SHA256=

# API verification is a secondary check after local Ed25519 verification.
VERIGATE_BASE_URL=http://127.0.0.1:8000
VERIGATE_API_KEY=
