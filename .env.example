# Reported PortalDot V3 EVM testnet settings (17 Oct 2026); the canonical announcement URL is not yet recorded here.
# Do not deploy or use test funds until PortalDot independently confirms the endpoint, chain ID, and EVM denomination.
# `PORTALDOT_GENESIS_HASH` must be filled from an independent trusted source, not blindly copied from this RPC.
# Preflight, deployment and bridge signing refuse to proceed while the genesis hash pin is missing or mismatched.
PORTALDOT_RPC_URL=https://test-evm-rpc-v3.portaldot.dev
PORTALDOT_CHAIN_ID=420420777
# Required 32-byte hash of block 0 (0x + 64 hex chars), independently confirmed with PortalDot.
PORTALDOT_GENESIS_HASH=
PORTALDOT_GUARD_ADDRESS=
# Set only after independently verifying the deployed runtime bytecode hash.
PORTALDOT_GUARD_CODE_HASH=

# Required only for an actual deployment. Never commit the real value.
DEPLOYER_PRIVATE_KEY=

# Dedicated EVM bridge key. Its derived address must match the address configured in the contract.
BRIDGE_SIGNER_PRIVATE_KEY=
AUTHORITY_SIGNER_ADDRESS=

# Path to the trusted issuer public key PEM.
VERIGATE_PUBLIC_KEY_FILE=
# SHA-256 of the public key's DER SubjectPublicKeyInfo, independently verified via a trusted channel.
# Required; never derive the expected value from the same untrusted file at runtime.
VERIGATE_PUBLIC_KEY_SHA256=

# API verification is a secondary check after local Ed25519 verification.
VERIGATE_BASE_URL=http://127.0.0.1:8000
VERIGATE_API_KEY=
