{
  "name": "verigate-portaldot",
  "version": "0.1.0",
  "private": false,
  "description": "PortalDot V3 integration demo for Verigate agent execution authorization",
  "license": "MIT",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "compile": "hardhat build",
    "test": "hardhat test && npm run test:explorer",
    "preflight": "node scripts/preflight.js",
    "deploy:portaldot": "npm run preflight && hardhat run scripts/deploy.mjs --network portaldot",
    "deploy:v2:portaldot": "npm run preflight && hardhat run scripts/deploy-v2.mjs --network portaldot",
    "bridge:sign": "node adapter/verigate-bridge.js",
    "execute:authorization": "node scripts/execute-authorized-transfer.mjs",
    "monitor:rpc": "node scripts/monitor-rpc.js",
    "estimate:deployment": "npm run compile && node scripts/estimate-deployment.mjs",
    "address:substrate": "node scripts/portaldot-address.js",
    "address:inspect": "node scripts/inspect-account-mapping.js",
    "inspect:substrate-runtime": "node scripts/substrate-runtime-preflight.mjs",
    "verify:account-mapping": "node scripts/verify-account-mapping.mjs",
    "verify:deployer-address": "node scripts/verify-deployer-address.mjs",
    "verify:deployment": "node scripts/verify-live-deployment.mjs",
    "fund:demo-guard": "node scripts/fund-demo-guard.mjs",
    "verify:authorized-transfer": "node scripts/verify-authorized-transfer.mjs",
    "test:explorer": "node --experimental-sqlite --test services/explorer-service.test.mjs",
    "explorer:service": "node --experimental-sqlite services/explorer-service.mjs"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox-mocha-ethers": "^4.0.0",
    "dotenv": "^16.4.7",
    "ethers": "^6.13.4",
    "hardhat": "^3.20.0",
    "ts-node": "10.9.2",
    "typescript": "5.7.3"
  },
  "type": "module",
  "dependencies": {
    "@polkadot/api": "^17.0.2",
    "@polkadot/keyring": "^14.0.3",
    "@polkadot/util-crypto": "^14.0.3"
  }
}
